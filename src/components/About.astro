          <span data-es="Sobre Mí" data-en="About Me">Sobre Mí</span>
        </h2>
        <div class="w-24 h-1 bg-gradient-to-r from-primary-600 to-secondary-600 mx-auto rounded-full"></div>
        <p class="text-xl text-gray-600 mt-6 max-w-2xl mx-auto">
          <span data-es="Conoce mi historia, pasiones y enfoque en el desarrollo"
                data-en="Learn about my story, passions and approach to development">
            Conoce mi historia, pasiones y enfoque en el desarrollo
          </span>
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-16">
        <!-- Imagen y información personal -->
        <div class="space-y-8">
          <!-- Imagen principal -->
