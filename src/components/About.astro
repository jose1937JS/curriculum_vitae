              <i class="ph ph-code text-2xl text-primary-600 mb-2"></i>
              <div class="text-sm text-gray-600">
                <span data-es="Proyectos" data-en="Projects">Proyectos</span>
              </div>
              <div class="font-semibold text-gray-900">+16 
