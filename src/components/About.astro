---
// About Section - Información personal y biografía del desarrollador
---

<section id="about" class="py-20 bg-white relative z-20">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Título de sección -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          <span data-es="Sobre Mí" data-en="About Me">Sobre Mí</span>
        </h2>
        <div class="w-24 h-1 bg-gradient-to-r from-blue-600 to-purple-600 mx-auto rounded-full"></div>
        <p class="text-xl text-gray-600 mt-6 max-w-2xl mx-auto">
          <span data-es="Conoce mi historia, pasiones y enfoque en el desarrollo"
                data-en="Learn about my story, passions and approach to development">
            Conoce mi historia, pasiones y enfoque en el desarrollo
          </span>
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <!-- Imagen y información personal -->
        <div class="space-y-8">
          <!-- Imagen principal -->
          <div class="relative">
            <div class="w-full max-w-md mx-auto lg:mx-0">
              <div class="aspect-square rounded-2xl bg-gradient-to-br from-blue-100 to-purple-100 p-8 shadow-2xl">
                <!-- Placeholder para imagen profesional -->
                <div class="w-full h-full rounded-xl bg-gray-200 flex items-center justify-center">
                  <i class="ph ph-user text-6xl text-gray-400"></i>
                </div>
              </div>
              <!-- Elementos decorativos -->
              <div class="absolute -top-4 -right-4 w-24 h-24 bg-blue-500 rounded-full opacity-10 animate-pulse"></div>
              <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-purple-500 rounded-full opacity-10 animate-pulse delay-1000"></div>
            </div>
          </div>

          <!-- Información personal rápida -->
          <div class="grid grid-cols-3 gap-6">
            <div class="bg-gray-50 rounded-xl p-6 text-center hover:bg-gray-100 transition-colors duration-300">
              <i class="ph ph-map-pin text-2xl text-blue-600 mb-2"></i>
              <div class="text-sm text-gray-600">
                <span data-es="Ubicación" data-en="Location">Ubicación</span>
              </div>
              <div class="font-semibold text-gray-900">San Juan de los Morros, Venezuela</div>
            </div>
            <div class="bg-gray-50 rounded-xl p-6 text-center hover:bg-gray-100 transition-colors duration-300">
              <i class="ph ph-calendar text-2xl text-purple-600 mb-2"></i>
              <div class="text-sm text-gray-600">
                <span data-es="Experiencia" data-en="Experience">Experiencia</span>
              </div>
              <div class="font-semibold text-gray-900">+4 
                <span data-es="años" data-en="years">años</span>
              </div>
            </div>
            <div class="bg-gray-50 rounded-xl p-6 text-center hover:bg-gray-100 transition-colors duration-300">
              <i class="ph ph-code text-2xl text-purple-600 mb-2"></i>
              <div class="text-sm text-gray-600">
                <span data-es="Proyectos" data-en="Projects">Proyectos</span>
              </div>
              <div class="font-semibold text-gray-900">+16 
                <span data-es="proyectos" data-en="projects">proyectos</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Biografía y detalles -->
        <div class="space-y-8">
          <!-- Historia personal -->
          <div>
            <h3 class="text-2xl font-bold text-gray-900 mb-6">
              <span data-es="Mi Historia" data-en="My Story">Mi Historia</span>
            </h3>
            <div class="space-y-4 text-gray-700 leading-relaxed">
              <p>
                <span data-es="Soy un desarrollador apasionado por la tecnología y la innovación, con más de 4 años de experiencia creando soluciones digitales que realmente impactan en la vida de las personas. Mi viaje en el mundo del desarrollo comenzó cuando [personalizar con tu historia personal]."
                      data-en="I am a developer passionate about technology and innovation, with more than 4 years of experience creating digital solutions that really impact people's lives. My journey in the development world began when [customize with your personal story].">
                  Soy un desarrollador apasionado por la tecnología y la innovación, con más de 4 años de experiencia creando soluciones digitales que realmente impactan en la vida de las personas. Mi viaje en el mundo del desarrollo comenzó cuando [personalizar con tu historia personal].
                </span>
              </p>
              <p>
                <span data-es="Especializado en desarrollo full stack y aplicaciones móviles híbridas, me enfoco en crear experiencias de usuario excepcionales utilizando las últimas tecnologías. Mi filosofía de trabajo se basa en la colaboración, la innovación constante y la entrega de código limpio y escalable."
                      data-en="Specialized in full stack development and hybrid mobile applications, I focus on creating exceptional user experiences using the latest technologies. My work philosophy is based on collaboration, constant innovation and delivering clean and scalable code.">
                  Especializado en desarrollo full stack y aplicaciones móviles híbridas, me enfoco en crear experiencias de usuario excepcionales utilizando las últimas tecnologías. Mi filosofía de trabajo se basa en la colaboración, la innovación constante y la entrega de código limpio y escalable.
                </span>
              </p>
            </div>
          </div>

          <!-- Pasiones y enfoque -->
          <div>
            <h3 class="text-2xl font-bold text-gray-900 mb-6">
              <span data-es="Mis Pasiones" data-en="My Passions">Mis Pasiones</span>
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex items-center space-x-3 p-4 bg-blue-50 rounded-lg hover:bg-blue-100 transition-colors duration-300">
                <i class="ph ph-code text-xl text-blue-600"></i>
                <span class="text-gray-800 font-medium">
                  <span data-es="Código Limpio" data-en="Clean Code">Código Limpio</span>
                </span>
              </div>
              <div class="flex items-center space-x-3 p-4 bg-purple-50 rounded-lg hover:bg-purple-100 transition-colors duration-300">
                <i class="ph ph-devices text-xl text-purple-600"></i>
                <span class="text-gray-800 font-medium">
                  <span data-es="UX/UI Design" data-en="UX/UI Design">UX/UI Design</span>
                </span>
              </div>
              <div class="flex items-center space-x-3 p-4 bg-green-50 rounded-lg hover:bg-green-100 transition-colors duration-300">
                <i class="ph ph-lightning text-xl text-green-600"></i>
                <span class="text-gray-800 font-medium">
                  <span data-es="Performance" data-en="Performance">Performance</span>
                </span>
              </div>
              <div class="flex items-center space-x-3 p-4 bg-orange-50 rounded-lg hover:bg-orange-100 transition-colors duration-300">
                <i class="ph ph-users text-xl text-orange-600"></i>
                <span class="text-gray-800 font-medium">
                  <span data-es="Trabajo en Equipo" data-en="Teamwork">Trabajo en Equipo</span>
                </span>
              </div>
            </div>
          </div>

          <!-- Valores y filosofía -->
          <div>
            <h3 class="text-2xl font-bold text-gray-900 mb-6">
              <span data-es="Mi Enfoque" data-en="My Approach">Mi Enfoque</span>
            </h3>
            <div class="space-y-4">
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-blue-600 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                  <i class="ph ph-check text-white text-sm"></i>
                </div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-1">
                    <span data-es="Orientado a Resultados" data-en="Results Oriented">Orientado a Resultados</span>
                  </h4>
                  <p class="text-gray-600 text-sm">
                    <span data-es="Cada línea de código tiene un propósito claro y medible" 
                          data-en="Every line of code has a clear and measurable purpose">
                      Cada línea de código tiene un propósito claro y medible
                    </span>
                  </p>
                </div>
              </div>
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-purple-600 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                  <i class="ph ph-check text-white text-sm"></i>
                </div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-1">
                    <span data-es="Aprendizaje Continuo" data-en="Continuous Learning">Aprendizaje Continuo</span>
                  </h4>
                  <p class="text-gray-600 text-sm">
                    <span data-es="Siempre explorando nuevas tecnologías y mejores prácticas"
                          data-en="Always exploring new technologies and best practices">
                      Siempre explorando nuevas tecnologías y mejores prácticas
                    </span>
                  </p>
                </div>
              </div>
              <div class="flex items-start space-x-4">
                <div class="w-8 h-8 bg-green-600 rounded-full flex items-center justify-center flex-shrink-0 mt-1">
                  <i class="ph ph-check text-white text-sm"></i>
                </div>
                <div>
                  <h4 class="font-semibold text-gray-900 mb-1">
                    <span data-es="Colaboración Efectiva" data-en="Effective Collaboration">Colaboración Efectiva</span>
                  </h4>
                  <p class="text-gray-600 text-sm">
                    <span data-es="Creo que los mejores productos nacen del trabajo en equipo"
                          data-en="I believe the best products are born from teamwork">
                      Creo que los mejores productos nacen del trabajo en equipo
                    </span>
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Call to action -->
          <div class="pt-6">
            <a href="#contact" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white font-medium rounded-lg hover:from-blue-700 hover:to-purple-700 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl group">
              <span data-es="¡Trabajemos Juntos!" data-en="Let's Work Together!">¡Trabajemos Juntos!</span>
              <i class="ph ph-arrow-right ml-2 group-hover:translate-x-1 transition-transform duration-300"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Animaciones de entrada cuando el elemento es visible
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-fade-in-up');
      }
    });
  }, observerOptions);

  // Observar elementos para animaciones
  document.addEventListener('DOMContentLoaded', () => {
    const animatedElements = document.querySelectorAll('#about .grid > div, #about .space-y-8 > div');
    animatedElements.forEach(el => observer.observe(el));
  });
</script>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  /* Efectos hover para las cards de pasiones */
  .hover\:bg-blue-100:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
  }

  .hover\:bg-purple-100:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(147, 51, 234, 0.15);
  }

  .hover\:bg-green-100:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(34, 197, 94, 0.15);
  }

  .hover\:bg-orange-100:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(249, 115, 22, 0.15);
  }

  /* Animación sutil para elementos decorativos */
  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .delay-1000 {
    animation-delay: 1s;
  }
</style>