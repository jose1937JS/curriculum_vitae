<script>
  // Animaciones de entrada para elementos del timeline
  const observerOptions = {
    threshold: 0.2,
    rootMargin: '0px 0px -100px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        setTimeout(() => {
          entry.target.classList.add('animate-fade-in-up');
        }, index * 200);
      }
    });
  }, observerOptions);

  document.addEventListener('DOMContentLoaded', () => {
    const experienceItems = document.querySelectorAll('.experience-item');
    experienceItems.forEach(item => observer.observe(item));
  });
</script>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(50px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  /* Efectos hover mejorados */
  .experience-item .bg-white:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  /* Línea del timeline con gradiente animado */
  .absolute.w-0\.5 {
    background: linear-gradient(180deg, var(--brand-orange-600) 0%, var(--brand-yellow-600) 100%);
    box-shadow: 0 0 20px rgba(254, 75, 0, 0.3);
  }

  /* Marcadores del timeline con animación */
  .experience-item .absolute.w-4.h-4 {
    transition: all 0.3s ease;
  }

  .experience-item:hover .absolute.w-4.h-4 {
    transform: translateX(-50%) scale(1.2);
    box-shadow: 0 0 15px rgba(254, 75, 0, 0.5);
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .experience-item .absolute.w-4.h-4 {
      left: 1.5rem;
      transform: none;
    }
    
    .experience-item:hover .absolute.w-4.h-4 {
      transform: scale(1.2);
    }
  }
</style>