<script>
  // Efecto de escritura para el título de rol
  document.addEventListener('DOMContentLoaded', () => {
    const roles = {
      es: [
        'Desarrollador Full Stack',
        'Desarrollador Móvil Híbrido',
        'Especialista en React/Vue',
        'Desarrollador Backend',
        'Creador de Soluciones'
      ],
      en: [
        'Full Stack Developer',
        'Hybrid Mobile Developer',
        'React/Vue Specialist',
        'Backend Developer',
        'Solution Creator'
      ]
    };

    let currentLang = 'es';
    let currentRoleIndex = 0;
    const typingElement = document.querySelector('.typing-animation span') as HTMLElement;

    function typeWriter(text: string, callback: () => void) {
      if (!typingElement) return;
      
      let i = 0;
      typingElement.textContent = '';
      
      function type() {
        if (i < text.length) {
          typingElement.textContent += text.charAt(i);
          i++;
          setTimeout(type, 100);
        } else if (callback) {
          setTimeout(callback, 2000);
        }
      }
      
      type();
    }

    function eraseText(callback: () => void) {
      if (!typingElement) return;
      
      const text = typingElement.textContent || '';
      let i = text.length;
      
      function erase() {
        if (i > 0) {
          typingElement.textContent = text.substring(0, i - 1);
          i--;
          setTimeout(erase, 50);
        } else if (callback) {
          setTimeout(callback, 500);
        }
      }
      
      erase();
    }

    function cycleRoles() {
      const currentRoles = roles[currentLang as keyof typeof roles];
      const nextRole = currentRoles[currentRoleIndex];
      
      eraseText(() => {
        typeWriter(nextRole, () => {
          currentRoleIndex = (currentRoleIndex + 1) % currentRoles.length;
          setTimeout(cycleRoles, 1000);
        });
      });
    }

    // Iniciar el ciclo de roles
    setTimeout(cycleRoles, 1000);

    // Escuchar cambios de idioma
    document.addEventListener('languageChanged', (e: Event) => {
      const customEvent = e as CustomEvent<{ lang: string }>;
      currentLang = customEvent.detail.lang;
      currentRoleIndex = 0;
    });
  });

  // Animación de partículas interactiva con el mouse
  document.addEventListener('DOMContentLoaded', () => {
    const canvas = document.getElementById('particles-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = canvas.width = canvas.offsetWidth;
    let height = canvas.height = canvas.offsetHeight;

    window.addEventListener('resize', () => {
      if (!canvas) return;
      width = canvas.width = canvas.offsetWidth;
      height = canvas.height = canvas.offsetHeight;
    });

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      color: string;
      originalVx: number;
      originalVy: number;
    }

    const particles: Particle[] = [];
    const particleCount = Math.min(80, Math.floor((width * height) / 12000));
    const connectionDistance = 110;
    const mouse = { x: null as number | null, y: null as number | null, radius: 140 };

    for (let i = 0; i < particleCount; i++) {
      const vx = (Math.random() - 0.5) * 0.5;
      const vy = (Math.random() - 0.5) * 0.5;
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        vx,
        vy,
        originalVx: vx,
        originalVy: vy,
        radius: Math.random() * 2 + 1,
        color: Math.random() > 0.25 ? '#fe4b00' : '#ffb700', // 75% rojo-naranja, 25% amarillo
      });
    }

    const homeSection = document.getElementById('home');
    homeSection?.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    homeSection?.addEventListener('mouseleave', () => {
      mouse.x = null;
      mouse.y = null;
    });

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      // Dibujar y conectar partículas
      for (let i = 0; i < particles.length; i++) {
        const p1 = particles[i];

        // Mover partícula
        p1.x += p1.vx;
        p1.y += p1.vy;

        // Limites
        if (p1.x < 0 || p1.x > width) p1.vx *= -1;
        if (p1.y < 0 || p1.y > height) p1.vy *= -1;

        // Interacción mouse
        if (mouse.x !== null && mouse.y !== null) {
          const dx = mouse.x - p1.x;
          const dy = mouse.y - p1.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < mouse.radius) {
            const force = (mouse.radius - dist) / mouse.radius;
            // Atraer levemente hacia el mouse
            p1.x += (dx / dist) * force * 0.4;
            p1.y += (dy / dist) * force * 0.4;
          }
        }

        // Dibujar partícula
        ctx.beginPath();
        ctx.arc(p1.x, p1.y, p1.radius, 0, Math.PI * 2);
        ctx.fillStyle = p1.color;
        ctx.fill();

        // Conectar con otras partículas
        for (let j = i + 1; j < particles.length; j++) {
          const p2 = particles[j];
          const dx = p1.x - p2.x;
          const dy = p1.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < connectionDistance) {
            const alpha = (1 - dist / connectionDistance) * 0.12;
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.strokeStyle = `rgba(254, 75, 0, ${alpha})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }

        // Conectar con el ratón
        if (mouse.x !== null && mouse.y !== null) {
          const dx = p1.x - mouse.x;
          const dy = p1.y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < mouse.radius) {
            const alpha = (1 - dist / mouse.radius) * 0.22;
            ctx.beginPath();
            ctx.moveTo(p1.x, p1.y);
            ctx.lineTo(mouse.x, mouse.y);
            ctx.strokeStyle = `rgba(255, 183, 0, ${alpha})`;
            ctx.lineWidth = 0.7;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(animate);
    }

    animate();
  });
</script>

<style>
  .btn-primary {
    @apply inline-flex items-center px-8 py-3 bg-gradient-to-r from-primary-600 to-secondary-600 text-white font-medium rounded-lg hover:from-primary-700 hover:to-secondary-700 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl;
  }

  .btn-secondary {
    @apply inline-flex items-center px-8 py-3 border-2 border-primary-600 text-primary-600 font-medium rounded-lg hover:bg-primary-600 hover:text-white transition-all duration-300 transform hover:scale-105;
  }

  .social-link {
    @apply w-12 h-12 bg-white rounded-full flex items-center justify-center text-gray-600 hover:text-primary-600 hover:bg-primary-50 transition-all duration-300 shadow-md hover:shadow-lg transform hover:scale-110;
  }

  .typing-animation {
    @apply inline-block;
  }

  .typing-animation::after {
    content: '|';
    @apply animate-pulse text-primary-600;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
  }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
</style>