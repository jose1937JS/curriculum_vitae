                <span class="tech-tag bg-yellow-400 text-white">Javascript</span>
                <span class="tech-tag bg-purple-600 text-white">Bootstrapcss</span>
                <span class="tech-tag bg-indigo-400 text-indigo-100">PHP</span>
                <span class="tech-tag bg-sky-700 text-sky-100">MySQL</span>
              </div>
            </div>
          </div>
