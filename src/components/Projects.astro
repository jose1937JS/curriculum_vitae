<script>
  // Sistema de filtros para proyectos
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Actualizar botones activos
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        // Filtrar proyectos
        projectCards.forEach((card: Element) => {
          const categories = (card as HTMLElement).getAttribute('data-category')?.split(' ') ?? [];
          
          if (filter === 'all' || categories.includes(filter ?? '')) {
            (card as HTMLElement).style.display = 'block';
            (card as HTMLElement).style.opacity = '0';
            (card as HTMLElement).style.transform = 'translateY(20px)';
            
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'translateY(0)';
            }, 100);
          } else {
            (card as HTMLElement).style.opacity = '0';
            (card as HTMLElement).style.transform = 'translateY(-20px)';
            
            setTimeout(() => {
              (card as HTMLElement).style.display = 'none';
            }, 300);
          }
        });
      });
    });

    // Animaciones de entrada
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('animate-fade-in-up');
          }, index * 100);
        }
      });
    }, observerOptions);

    projectCards.forEach(card => observer.observe(card));

    // Reorganizar masonry en resize
    let resizeTimer: NodeJS.Timeout;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        reorganizeMasonry();
      }, 250);
    });

    // Función para reorganizar el masonry
    function reorganizeMasonry() {
      const grid = document.getElementById('projects-grid');
      if (grid) {
        // Forzar reflow del grid para que las columnas se reorganizen
        grid.style.display = 'none';
        grid.offsetHeight; // Trigger reflow
        grid.style.display = 'block';
      }
    }
  });
</script>

