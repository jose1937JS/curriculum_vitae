---
// Projects Section - Galería de proyectos del desarrollador
import ProjectCard from "./ProjectCard.astro";
import { proyectos } from "../data/projects";

---

<section id="projects" class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-7xl mx-auto">
      <!-- Título de sección -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          <span data-es="Mis Proyectos" data-en="My Projects">Mis Proyectos</span>
        </h2>
        <div class="w-24 h-1 bg-gradient-to-r from-primary-600 to-secondary-600 mx-auto rounded-full"></div>
        <p class="text-xl text-gray-600 mt-6 max-w-2xl mx-auto">
          <span data-es="Una selección de proyectos que demuestran mis habilidades y experiencia" 
                data-en="A selection of projects that demonstrate my skills and experience">
            Una selección de proyectos que demuestran mis habilidades y experiencia
          </span>
        </p>
      </div>

      <!-- Filtros de proyectos -->
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <button class="filter-btn active" data-filter="all">
          <span data-es="Todos" data-en="All">Todos</span>
        </button>
        <button class="filter-btn" data-filter="mobile">
          <span data-es="Apps Móviles" data-en="Mobile Apps">Apps Móviles</span>
        </button>
        <button class="filter-btn" data-filter="fullstack">
          <span data-es="Full Stack" data-en="Full Stack">Full Stack</span>
        </button>
        <button class="filter-btn" data-filter="frontend">
          <span data-es="Frontend" data-en="Frontend">Frontend</span>
        </button>
        <button class="filter-btn" data-filter="backend">
          <span data-es="Backend" data-en="Backend">Backend</span>
        </button>
      </div>

      <!-- Grid de proyectos -->
      <div class="container-masonry" id="projects-grid">
        {proyectos.map((proyecto) => (
          <ProjectCard {...proyecto} />
        ))}
      </div>
    </div>
  </div>
</section>

<!-- Modal para galería de imágenes -->
<div id="imageModal" class="fixed inset-0 z-50 hidden bg-black bg-opacity-90 flex justify-center">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="relative w-[70vw] max-w-7xl max-h-[90vh] bg-gray-200 rounded-2xl shadow-2xl flex flex-col">
      <!-- Header del modal -->
      <div class="flex items-center justify-between p-6 bg-gray-50 border-b flex-shrink-0">
        <h3 class="text-2xl font-bold text-gray-900" id="modalTitle">
          <span data-es="Galería del Proyecto" data-en="Project Gallery">Galería del Proyecto</span>
        </h3>
        <button id="closeModalBtn" class="text-gray-400 hover:text-gray-600 transition-colors">
          <i class="ph ph-x text-3xl"></i>
        </button>
      </div>
      
      <!-- Carrusel de imágenes con scroll -->
      <div class="relative p-6 flex-1 overflow-y-auto overflow-x-hidden">
        <!-- Botón anterior -->
        <button id="prevImageBtn" class="absolute left-8 top-1/2 transform -translate-y-1/2 z-10 bg-white bg-opacity-80 hover:bg-opacity-100 text-gray-800 p-3 rounded-full shadow-lg transition-all duration-300 hover:scale-110">
          <i class="ph ph-caret-left text-2xl"></i>
        </button>
        
        <!-- Botón siguiente -->
        <button id="nextImageBtn" class="absolute right-8 top-1/2 transform -translate-y-1/2 z-10 bg-white bg-opacity-80 hover:bg-opacity-100 text-gray-800 p-3 rounded-full shadow-lg transition-all duration-300 hover:scale-110">
          <i class="ph ph-caret-right text-2xl"></i>
        </button>
        
        <!-- Imagen principal -->
        <div class="flex justify-center items-start min-h-[50vh] pb-10">
          <img id="modalImage" src="" alt="Imagen del proyecto" class="max-w-full max-h-none object-contain rounded-lg shadow-lg">
        </div>
        
        <!-- Indicadores de navegación -->
        <div class="flex justify-center space-x-2" id="imageIndicators">
          <!-- Los indicadores se generan dinámicamente -->
        </div>
        
        <!-- Contador de imágenes -->
        <div class="text-center mt-3 text-gray-600">
          <span id="imageCounter">1 / 1</span>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  let currentImageIndex = 0;
  let currentImages = [];

  // Función para abrir el modal
  function openModal(projectImages) {
    currentImageIndex = 0;
    currentImages = projectImages;
    
    // Mostrar el modal
    const modal = document.getElementById('imageModal');
    if (!modal) return;
    
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    
    // Cargar la primera imagen
    loadImage(0);
    
    // Generar indicadores
    generateIndicators();
    
    // Prevenir scroll del body
    document.body.style.overflow = 'hidden';
    
    // Agregar event listeners para teclado
    document.addEventListener('keydown', handleKeyPress);
  }

  // Función para cerrar el modal
  function closeModal() {
    const modal = document.getElementById('imageModal');
    if (!modal) return;
    
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    
    // Restaurar scroll del body
    document.body.style.overflow = 'auto';
    
    // Remover event listeners
    document.removeEventListener('keydown', handleKeyPress);
  }

  // Función para cargar una imagen específica
  function loadImage(imageIndex) {
    if (imageIndex < 0 || imageIndex >= currentImages.length) return;
    
    currentImageIndex = imageIndex;
    const modalImage = document.getElementById('modalImage');
    const imageCounter = document.getElementById('imageCounter');
    
    if (!modalImage || !imageCounter) return;
    
    // Cargar la imagen
    modalImage.src = currentImages[imageIndex];
    modalImage.alt = `Imagen ${imageIndex + 1} del proyecto`;
    
    // Actualizar contador
    imageCounter.textContent = `${imageIndex + 1} / ${currentImages.length}`;
    
    // Actualizar indicadores activos
    updateActiveIndicator();
  }

  // Función para la imagen anterior
  function previousImage() {
    const newIndex = currentImageIndex > 0 ? currentImageIndex - 1 : currentImages.length - 1;
    loadImage(newIndex);
  }

  // Función para la imagen siguiente
  function nextImage() {
    const newIndex = currentImageIndex < currentImages.length - 1 ? currentImageIndex + 1 : 0;
    loadImage(newIndex);
  }

  // Función para generar indicadores
  function generateIndicators() {
    const indicatorsContainer = document.getElementById('imageIndicators');
    if (!indicatorsContainer) return;
    
    indicatorsContainer.innerHTML = '';
    
    currentImages.forEach((_, index) => {
      const indicator = document.createElement('button');
      indicator.className = 'w-3 h-3 rounded-full bg-gray-300 hover:bg-gray-400 transition-colors duration-200';
      indicator.onclick = () => loadImage(index);
      indicatorsContainer.appendChild(indicator);
    });
    
    updateActiveIndicator();
  }

  // Función para actualizar indicador activo
  function updateActiveIndicator() {
    const indicators = document.querySelectorAll('#imageIndicators button');
    indicators.forEach((indicator, index) => {
      if (index === currentImageIndex) {
        indicator.classList.remove('bg-gray-300');
        indicator.classList.add('bg-primary-600');
      } else {
        indicator.classList.remove('bg-primary-600');
        indicator.classList.add('bg-gray-300');
      }
    });
  }

  // Función para manejar teclas
  function handleKeyPress(event) {
    switch(event.key) {
      case 'Escape':
        closeModal();
        break;
      case 'ArrowLeft':
        previousImage();
        break;
      case 'ArrowRight':
        nextImage();
        break;
    }
  }

  // Event listeners cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', function() {
    // Event listeners para los botones de galería
    const galleryButtons = document.querySelectorAll('.gallery-button');
    galleryButtons.forEach(button => {
      button.addEventListener('click', function(event) {
        const imagesData = this.getAttribute('data-images');
        const projectImages = imagesData ? JSON.parse(imagesData) : [];
        openModal(projectImages);
      });
    });

    // Event listeners para los botones del modal
    const closeModalBtn = document.getElementById('closeModalBtn');
    const prevImageBtn = document.getElementById('prevImageBtn');
    const nextImageBtn = document.getElementById('nextImageBtn');
    
    if (closeModalBtn) {
      closeModalBtn.addEventListener('click', closeModal);
    }
    
    if (prevImageBtn) {
      prevImageBtn.addEventListener('click', previousImage);
    }
    
    if (nextImageBtn) {
      nextImageBtn.addEventListener('click', nextImage);
    }

    // Cerrar modal al hacer clic fuera de él
    const modalElement = document.getElementById('imageModal');
    if (modalElement) {
      modalElement.addEventListener('click', function(event) {
        if (event.target === this) {
          closeModal();
        }
      });
    }

    // Sistema de filtros para proyectos
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', function() {
        // Actualizar botones activos
        filterButtons.forEach(b => b.classList.remove('active'));
        this.classList.add('active');

        const filter = this.getAttribute('data-filter');
        // Filtrar proyectos
        projectCards.forEach(card => {
          const categories = card.getAttribute('data-category')?.split(' ') || [];
          
          if (filter === 'all' || categories.includes(filter)) {
            card.style.display = 'block';
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            
            setTimeout(() => {
              card.style.opacity = '1';
              card.style.transform = 'translateY(0)';
            }, 100);
          } else {
            card.style.opacity = '0';
            card.style.transform = 'translateY(-20px)';
            
            setTimeout(() => {
              card.style.display = 'none';
            }, 300);
          }
        });
      });
    });

    // Animaciones de entrada
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('animate-fade-in-up');
          }, index * 100);
        }
      });
    }, observerOptions);

    projectCards.forEach(card => observer.observe(card));

    // Reorganizar masonry en resize
    let resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function() {
        reorganizeMasonry();
      }, 250);
    });

    // Función para reorganizar el masonry
    function reorganizeMasonry() {
      const grid = document.getElementById('projects-grid');
      if (grid) {
        // Forzar reflow del grid para que las columnas se reorganizen
        grid.style.display = 'none';
        grid.offsetHeight; // Trigger reflow
        grid.style.display = 'block';
      }
    }
  });
</script>

<style>
  .filter-btn {
    @apply px-6 py-3 rounded-full text-gray-600 font-medium transition-all duration-300 hover:bg-gray-100 hover:text-gray-900;
  }

  .filter-btn.active {
    @apply bg-gradient-to-r from-primary-600 to-secondary-600 text-white transform scale-105;
  }

  .project-btn {
    @apply inline-flex items-center space-x-2 px-4 py-2 bg-white bg-opacity-20 backdrop-blur-sm text-white font-medium rounded-lg hover:bg-opacity-30 transition-all duration-300 transform hover:scale-105;
  }

  .tech-tag {
    @apply px-3 py-1 rounded-full text-xs font-medium;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  /* Efectos hover mejorados */
  .project-card:hover .tech-tag {
    transform: translateY(-2px);
  }

  /* Gradientes animados para las imágenes de fondo */
  .project-card .relative::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, transparent 0%, rgba(255,255,255,0.1) 50%, transparent 100%);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .project-card:hover .relative::before {
    transform: translateX(100%);
  }

  /* Contenedor principal con efecto de "masonería" */
  .container-masonry {
    column-count: 3; /* Número de columnas en el diseño */
    column-gap: 2rem; /* Espacio entre las columnas */
    width: 100%;
  }
  
  /* Estilos para cada tarjeta de proyecto */
  .project-card {
    display: inline-block; /* Importante para que el column-count funcione */
    width: 100%;
    border-radius: 1rem;
    box-sizing: border-box;
    -webkit-column-break-inside: avoid; /* Previene que la tarjeta se parta en dos columnas */
    page-break-inside: avoid;
    break-inside: avoid-column;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Media queries para un diseño responsivo */
  @media (max-width: 1024px) {
    .container-masonry {
      column-count: 2;
    }
  }

  @media (max-width: 640px) {
    .container-masonry {
      column-count: 1;
    }
  }
</style>