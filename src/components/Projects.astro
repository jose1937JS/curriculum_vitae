<script>
  // Sistema de filtros para proyectos
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Actualizar botones activos
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        // Filtrar proyectos
        projectCards.forEach((card: Element) => {
          const categories = (card as HTMLElement).getAttribute('data-category')?.split(' ') ?? [];
          
          if (filter === 'all' || categories.includes(filter ?? '')) {
            (card as HTMLElement).style.display = 'block';
            (card as HTMLElement).style.opacity = '0';
            (card as HTMLElement).style.transform = 'translateY(20px)';
            
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'translateY(0)';
            }, 100);
          } else {
            (card as HTMLElement).style.opacity = '0';
            (card as HTMLElement).style.transform = 'translateY(-20px)';
            
            setTimeout(() => {
              (card as HTMLElement).style.display = 'none';
            }, 300);
          }
        });
      });
    });

    // Animaciones de entrada
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry, index) => {
        if (entry.isIntersecting) {
          setTimeout(() => {
            entry.target.classList.add('animate-fade-in-up');
          }, index * 100);
        }
      });
    }, observerOptions);

    projectCards.forEach(card => observer.observe(card));
  });
</script>

<style>
  .filter-btn {
    @apply px-6 py-3 rounded-full text-gray-600 font-medium transition-all duration-300 hover:bg-gray-100 hover:text-gray-900;
  }

  .filter-btn.active {
    @apply bg-gradient-to-r from-blue-600 to-purple-600 text-white transform scale-105;
  }

  .project-btn {
    @apply inline-flex items-center space-x-2 px-4 py-2 bg-white bg-opacity-20 backdrop-blur-sm text-white font-medium rounded-lg hover:bg-opacity-30 transition-all duration-300 transform hover:scale-105;
  }

  .tech-tag {
    @apply px-3 py-1 rounded-full text-xs font-medium;
  }

  .project-card {
    transition: all 0.3s ease;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
  }

  /* Efectos hover mejorados */
  .project-card:hover .tech-tag {
    transform: translateY(-2px);
  }

  /* Gradientes animados para las imágenes de fondo */
  .project-card .relative::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, transparent 0%, rgba(255,255,255,0.1) 50%, transparent 100%);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }

  .project-card:hover .relative::before {
    transform: translateX(100%);
  }
</style>