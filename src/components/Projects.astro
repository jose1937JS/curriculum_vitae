---
// Projects Section - Galería de proyectos del desarrollador
---

<section id="projects" class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="max-w-7xl mx-auto">
      <!-- Título de sección -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          <span data-es="Mis Proyectos" data-en="My Projects">Mis Proyectos</span>
        </h2>
        <div class="w-24 h-1 bg-gradient-to-r from-blue-600 to-purple-600 mx-auto rounded-full"></div>
        <p class="text-xl text-gray-600 mt-6 max-w-2xl mx-auto">
          <span data-es="Una selección de proyectos que demuestran mis habilidades y experiencia" 
                data-en="A selection of projects that demonstrate my skills and experience">
            Una selección de proyectos que demuestran mis habilidades y experiencia
          </span>
        </p>
      </div>

      <!-- Filtros de proyectos -->
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <button class="filter-btn active" data-filter="all">
          <span data-es="Todos" data-en="All">Todos</span>
        </button>
        <button class="filter-btn" data-filter="web">
          <span data-es="Web Apps" data-en="Web Apps">Web Apps</span>
        </button>
        <button class="filter-btn" data-filter="mobile">
          <span data-es="Apps Móviles" data-en="Mobile Apps">Apps Móviles</span>
        </button>
        <button class="filter-btn" data-filter="fullstack">
          <span data-es="Full Stack" data-en="Full Stack">Full Stack</span>
        </button>
      </div>

      <!-- Grid de proyectos -->
      <div class="grid lg:grid-cols-3 md:grid-cols-2 grid-cols-1 gap-8" id="projects-grid">
        
        <!-- Proyecto 1: E-commerce Platform -->
        <div class="project-card group" data-category="fullstack web" data-aos="fade-up">
          <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2">
            <!-- Imagen del proyecto -->
            <div class="relative h-48 bg-gradient-to-br from-blue-100 to-purple-100 overflow-hidden">
              <div class="absolute inset-0 flex items-center justify-center">
                <i class="ph ph-storefront text-6xl text-blue-600"></i>
              </div>
              <!-- Overlay con botones de acción -->
              <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-75 transition-all duration-300 flex items-center justify-center opacity-0 group-hover:opacity-100">
                <div class="flex space-x-4">
                  <a href="#" class="project-btn">
                    <i class="ph ph-eye"></i>
                    <span data-es="Demo" data-en="Demo">Demo</span>
                  </a>
                  <a href="#" class="project-btn">
                    <i class="ph ph-github-logo"></i>
                    <span data-es="Código" data-en="Code">Código</span>
                  </a>
                </div>
              </div>
            </div>
            
            <!-- Contenido del proyecto -->
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-3">
                <span data-es="Plataforma E-commerce" data-en="E-commerce Platform">Plataforma E-commerce</span>
              </h3>
              <p class="text-gray-600 mb-4 leading-relaxed">
                <span data-es="Una plataforma completa de comercio electrónico con carrito de compras, pasarela de pagos, panel administrativo y gestión de inventario en tiempo real."
                      data-en="A complete e-commerce platform with shopping cart, payment gateway, admin panel and real-time inventory management.">
                  Una plataforma completa de comercio electrónico con carrito de compras, pasarela de pagos, panel administrativo y gestión de inventario en tiempo real.
                </span>
              </p>
              
              <!-- Tecnologías utilizadas -->
              <div class="flex flex-wrap gap-2 mb-4">
                <span class="tech-tag bg-blue-100 text-blue-700">React</span>
                <span class="tech-tag bg-green-100 text-green-700">Node.js</span>
                <span class="tech-tag bg-purple-100 text-purple-700">MongoDB</span>
                <span class="tech-tag bg-yellow-100 text-yellow-700">Stripe</span>
              </div>
              
              <!-- Métricas del proyecto -->
              <div class="grid grid-cols-2 gap-4 pt-4 border-t border-gray-100">
                <div class="text-center">
                  <div class="font-bold text-blue-600">50k+</div>
                  <div class="text-xs text-gray-500">
                    <span data-es="Usuarios" data-en="Users">Usuarios</span>
                  </div>
                </div>
                <div class="text-center">
                  <div class="font-bold text-green-600">$1M+</div>
                  <div class="text-xs text-gray-500">
                    <span data-es="Ventas" data-en="Sales">Ventas</span>
                  </div>
                </div>
              </div>
            </div>
