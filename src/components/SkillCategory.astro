---
import SkillCard from "./SkillCard.astro";

export interface Props {
  titleEs: string;
  titleEn: string;
  descriptionEs: string;
  descriptionEn: string;
  icon: string;
  aosDelay?: string;
  skills: Array<{
    name: string;
    iconSrc?: string;
    phIcon?: string;
    iconClass?: string;
    iconWidth?: number;
    iconHeight?: number;
  }>;
}

const {
  titleEs,
  titleEn,
  descriptionEs,
  descriptionEn,
  icon,
  aosDelay,
  skills
} = Astro.props;
---

<div class="skill-category" data-aos="fade-up" data-aos-delay={aosDelay}>
  <div class="text-center mb-12">
    <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-secondary-600 to-primary-600 rounded-xl mb-4">
      <i class={`${icon} text-2xl text-white`}></i>
    </div>
    <h3 class="text-2xl font-bold text-gray-700 mb-2">
      <span data-es={titleEs} data-en={titleEn}>{titleEs}</span>
    </h3>
    <p class="text-gray-600 max-w-lg mx-auto">
      <span data-es={descriptionEs} data-en={descriptionEn}>
        {descriptionEs}
      </span>
    </p>
  </div>
  
  <div class="flex flex-wrap justify-center gap-6">
    {skills.map((skill) => (
      <SkillCard {...skill} />
    ))}
  </div>
</div>
