---
// Skills Section - Habilidades técnicas y herramientas del desarrollador
---

<section id="skills" class="py-20 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="max-w-7xl mx-auto">
      <!-- Título de sección -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
          <span data-es="Habilidades y Herramientas" data-en="Skills & Tools">Habilidades y Herramientas</span>
        </h2>
        <div class="w-24 h-1 bg-gradient-to-r from-blue-600 to-purple-600 mx-auto rounded-full"></div>
        <p class="text-xl text-gray-600 mt-6 max-w-2xl mx-auto">
          <span data-es="Tecnologías y herramientas con las que trabajo para crear soluciones excepcionales" 
                data-en="Technologies and tools I work with to create exceptional solutions">
            Tecnologías y herramientas con las que trabajo para crear soluciones excepcionales
          </span>
        </p>
      </div>

      <!-- Categorías de habilidades -->
      <div class="space-y-16">
        
        <!-- Frontend Development -->
        <div class="skill-category" data-aos="fade-up">
          <div class="text-center mb-12">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-blue-600 to-purple-600 rounded-xl mb-4">
              <i class="ph ph-browser text-2xl text-white"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-2">
              <span data-es="Desarrollo Frontend" data-en="Frontend Development">Desarrollo Frontend</span>
            </h3>
            <p class="text-gray-600 max-w-lg mx-auto">
              <span data-es="Interfaces de usuario modernas y responsivas con las últimas tecnologías"
                    data-en="Modern and responsive user interfaces with the latest technologies">
                Interfaces de usuario modernas y responsivas con las últimas tecnologías
              </span>
            </p>
          </div>
          
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
            <!-- React -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors duration-300">
                <i class="ph ph-atom text-2xl text-blue-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">React</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-2 rounded-full" style="width: 95%"></div>
              </div>
              <span class="text-sm text-gray-600">95%</span>
            </div>

            <!-- Vue.js -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-green-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-green-200 transition-colors duration-300">
                <i class="ph ph-triangle text-2xl text-green-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Vue.js</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-green-500 to-green-600 h-2 rounded-full" style="width: 90%"></div>
              </div>
              <span class="text-sm text-gray-600">90%</span>
            </div>

            <!-- TypeScript -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors duration-300">
                <i class="ph ph-file-ts text-2xl text-blue-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">TypeScript</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-2 rounded-full" style="width: 88%"></div>
              </div>
              <span class="text-sm text-gray-600">88%</span>
            </div>

            <!-- Next.js -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-gray-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-gray-200 transition-colors duration-300">
                <i class="ph ph-lightning text-2xl text-gray-700"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Next.js</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-gray-500 to-gray-600 h-2 rounded-full" style="width: 85%"></div>
              </div>
              <span class="text-sm text-gray-600">85%</span>
            </div>

            <!-- Tailwind CSS -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-cyan-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-cyan-200 transition-colors duration-300">
                <i class="ph ph-paint-brush text-2xl text-cyan-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Tailwind</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-cyan-500 to-cyan-600 h-2 rounded-full" style="width: 92%"></div>
              </div>
              <span class="text-sm text-gray-600">92%</span>
            </div>

            <!-- SASS -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-pink-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-pink-200 transition-colors duration-300">
                <i class="ph ph-palette text-2xl text-pink-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">SASS</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-pink-500 to-pink-600 h-2 rounded-full" style="width: 80%"></div>
              </div>
              <span class="text-sm text-gray-600">80%</span>
            </div>
          </div>
        </div>

        <!-- Backend Development -->
        <div class="skill-category" data-aos="fade-up" data-aos-delay="200">
          <div class="text-center mb-12">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-green-600 to-blue-600 rounded-xl mb-4">
              <i class="ph ph-server text-2xl text-white"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-2">
              <span data-es="Desarrollo Backend" data-en="Backend Development">Desarrollo Backend</span>
            </h3>
            <p class="text-gray-600 max-w-lg mx-auto">
              <span data-es="APIs robustas y escalables con arquitecturas bien diseñadas"
                    data-en="Robust and scalable APIs with well-designed architectures">
                APIs robustas y escalables con arquitecturas bien diseñadas
              </span>
            </p>
          </div>
          
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
            <!-- Node.js -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-green-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-green-200 transition-colors duration-300">
                <i class="ph ph-leaf text-2xl text-green-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Node.js</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-green-500 to-green-600 h-2 rounded-full" style="width: 93%"></div>
              </div>
              <span class="text-sm text-gray-600">93%</span>
            </div>

            <!-- Python -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-yellow-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-yellow-200 transition-colors duration-300">
                <i class="ph ph-snake text-2xl text-yellow-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Python</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 h-2 rounded-full" style="width: 88%"></div>
              </div>
              <span class="text-sm text-gray-600">88%</span>
            </div>

            <!-- Express.js -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-gray-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-gray-200 transition-colors duration-300">
                <i class="ph ph-globe text-2xl text-gray-700"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Express.js</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-gray-500 to-gray-600 h-2 rounded-full" style="width: 90%"></div>
              </div>
              <span class="text-sm text-gray-600">90%</span>
            </div>

            <!-- Django -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-green-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-green-200 transition-colors duration-300">
                <i class="ph ph-gear text-2xl text-green-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Django</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-green-500 to-green-600 h-2 rounded-full" style="width: 82%"></div>
              </div>
              <span class="text-sm text-gray-600">82%</span>
            </div>

            <!-- GraphQL -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-pink-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-pink-200 transition-colors duration-300">
                <i class="ph ph-graph text-2xl text-pink-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">GraphQL</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-pink-500 to-pink-600 h-2 rounded-full" style="width: 78%"></div>
              </div>
              <span class="text-sm text-gray-600">78%</span>
            </div>

            <!-- REST APIs -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors duration-300">
                <i class="ph ph-arrows-split text-2xl text-blue-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">REST APIs</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-2 rounded-full" style="width: 95%"></div>
              </div>
              <span class="text-sm text-gray-600">95%</span>
            </div>
          </div>
        </div>

        <!-- Mobile Development -->
        <div class="skill-category" data-aos="fade-up" data-aos-delay="400">
          <div class="text-center mb-12">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-purple-600 to-pink-600 rounded-xl mb-4">
              <i class="ph ph-device-mobile text-2xl text-white"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-2">
              <span data-es="Desarrollo Móvil" data-en="Mobile Development">Desarrollo Móvil</span>
            </h3>
            <p class="text-gray-600 max-w-lg mx-auto">
              <span data-es="Aplicaciones móviles híbridas y nativas para iOS y Android"
                    data-en="Hybrid and native mobile applications for iOS and Android">
                Aplicaciones móviles híbridas y nativas para iOS y Android
              </span>
            </p>
          </div>
          
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
            <!-- React Native -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-cyan-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-cyan-200 transition-colors duration-300">
                <i class="ph ph-device-mobile text-2xl text-cyan-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">React Native</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-cyan-500 to-cyan-600 h-2 rounded-full" style="width: 92%"></div>
              </div>
              <span class="text-sm text-gray-600">92%</span>
            </div>

            <!-- Expo -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-indigo-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-indigo-200 transition-colors duration-300">
                <i class="ph ph-rocket text-2xl text-indigo-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Expo</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-indigo-500 to-indigo-600 h-2 rounded-full" style="width: 88%"></div>
              </div>
              <span class="text-sm text-gray-600">88%</span>
            </div>

            <!-- Flutter -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors duration-300">
                <i class="ph ph-butterfly text-2xl text-blue-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Flutter</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-2 rounded-full" style="width: 75%"></div>
              </div>
              <span class="text-sm text-gray-600">75%</span>
            </div>

            <!-- Ionic -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-teal-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-teal-200 transition-colors duration-300">
                <i class="ph ph-lightning text-2xl text-teal-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Ionic</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-teal-500 to-teal-600 h-2 rounded-full" style="width: 80%"></div>
              </div>
              <span class="text-sm text-gray-600">80%</span>
            </div>

            <!-- Cordova -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-orange-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-orange-200 transition-colors duration-300">
                <i class="ph ph-cube text-2xl text-orange-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Cordova</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-orange-500 to-orange-600 h-2 rounded-full" style="width: 70%"></div>
              </div>
              <span class="text-sm text-gray-600">70%</span>
            </div>

            <!-- PWA -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-purple-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-purple-200 transition-colors duration-300">
                <i class="ph ph-browser text-2xl text-purple-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">PWA</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-purple-500 to-purple-600 h-2 rounded-full" style="width: 85%"></div>
              </div>
              <span class="text-sm text-gray-600">85%</span>
            </div>
          </div>
        </div>

        <!-- Databases & Cloud -->
        <div class="skill-category" data-aos="fade-up" data-aos-delay="600">
          <div class="text-center mb-12">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-orange-600 to-red-600 rounded-xl mb-4">
              <i class="ph ph-database text-2xl text-white"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-2">
              <span data-es="Bases de Datos y Cloud" data-en="Databases & Cloud">Bases de Datos y Cloud</span>
            </h3>
            <p class="text-gray-600 max-w-lg mx-auto">
              <span data-es="Gestión de datos y servicios en la nube para aplicaciones escalables"
                    data-en="Data management and cloud services for scalable applications">
                Gestión de datos y servicios en la nube para aplicaciones escalables
              </span>
            </p>
          </div>
          
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
            <!-- MongoDB -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-green-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-green-200 transition-colors duration-300">
                <i class="ph ph-leaf text-2xl text-green-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">MongoDB</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-green-500 to-green-600 h-2 rounded-full" style="width: 90%"></div>
              </div>
              <span class="text-sm text-gray-600">90%</span>
            </div>

            <!-- PostgreSQL -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors duration-300">
                <i class="ph ph-database text-2xl text-blue-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">PostgreSQL</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-2 rounded-full" style="width: 85%"></div>
              </div>
              <span class="text-sm text-gray-600">85%</span>
            </div>

            <!-- MySQL -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-orange-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-orange-200 transition-colors duration-300">
                <i class="ph ph-cylinder text-2xl text-orange-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">MySQL</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-orange-500 to-orange-600 h-2 rounded-full" style="width: 80%"></div>
              </div>
              <span class="text-sm text-gray-600">80%</span>
            </div>

            <!-- AWS -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-yellow-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-yellow-200 transition-colors duration-300">
                <i class="ph ph-cloud text-2xl text-yellow-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">AWS</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 h-2 rounded-full" style="width: 88%"></div>
              </div>
              <span class="text-sm text-gray-600">88%</span>
            </div>

            <!-- Firebase -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-orange-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-orange-200 transition-colors duration-300">
                <i class="ph ph-flame text-2xl text-orange-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Firebase</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-orange-500 to-orange-600 h-2 rounded-full" style="width: 92%"></div>
              </div>
              <span class="text-sm text-gray-600">92%</span>
            </div>

            <!-- Redis -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-red-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-red-200 transition-colors duration-300">
                <i class="ph ph-lightning text-2xl text-red-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Redis</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-red-500 to-red-600 h-2 rounded-full" style="width: 75%"></div>
              </div>
              <span class="text-sm text-gray-600">75%</span>
            </div>
          </div>
        </div>

        <!-- Tools & DevOps -->
        <div class="skill-category" data-aos="fade-up" data-aos-delay="800">
          <div class="text-center mb-12">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-gray-600 to-gray-800 rounded-xl mb-4">
              <i class="ph ph-gear text-2xl text-white"></i>
            </div>
            <h3 class="text-2xl font-bold text-gray-900 mb-2">
              <span data-es="Herramientas y DevOps" data-en="Tools & DevOps">Herramientas y DevOps</span>
            </h3>
            <p class="text-gray-600 max-w-lg mx-auto">
              <span data-es="Herramientas de desarrollo y metodologías para equipos productivos"
                    data-en="Development tools and methodologies for productive teams">
                Herramientas de desarrollo y metodologías para equipos productivos
              </span>
            </p>
          </div>
          
          <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-6">
            <!-- Git -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-orange-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-orange-200 transition-colors duration-300">
                <i class="ph ph-git-branch text-2xl text-orange-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Git</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-orange-500 to-orange-600 h-2 rounded-full" style="width: 95%"></div>
              </div>
              <span class="text-sm text-gray-600">95%</span>
            </div>

            <!-- Docker -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-blue-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors duration-300">
                <i class="ph ph-cube text-2xl text-blue-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Docker</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-2 rounded-full" style="width: 85%"></div>
              </div>
              <span class="text-sm text-gray-600">85%</span>
            </div>

            <!-- Kubernetes -->
            <div class="skill-card group">
              <div class="w-16 h-16 bg-indigo-100 rounded-xl flex items-center justify-center mb-4 group-hover:bg-indigo-200 transition-colors duration-300">
                <i class="ph ph-circles-three text-2xl text-indigo-600"></i>
              </div>
              <h4 class="font-semibold text-gray-900 mb-2">Kubernetes</h4>
              <div class="w-full bg-gray-200 rounded-full h-2 mb-2">
                <div class="bg-gradient-to-r from-indigo-500 to-indigo-600 h-2 rounded-full" style="width: 70%"></div>
              </div>
              <span class="text-sm text-gray-600">70%</span>
            </div>

