<script>
  // Animaciones para las barras de progreso
  const observerOptions = {
    threshold: 0.3,
    rootMargin: '0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const progressBars = entry.target.querySelectorAll('.bg-gradient-to-r');
        progressBars.forEach((bar, index) => {
          setTimeout(() => {
            (bar as HTMLElement).style.transform = 'scaleX(1)';
            (bar as HTMLElement).style.transformOrigin = 'left';
          }, index * 200);
        });
      }
    });
  }, observerOptions);

  document.addEventListener('DOMContentLoaded', () => {
    // Inicializar barras de progreso en 0
    const progressBars = document.querySelectorAll('.bg-gradient-to-r');
    progressBars.forEach(bar => {
      if ((bar as HTMLElement).style.width) {
        (bar as HTMLElement).style.transform = 'scaleX(0)';
        (bar as HTMLElement).style.transition = 'transform 1s ease-out';
      }
    });

    // Observar categorías de habilidades
    const skillCategories = document.querySelectorAll('.skill-category');
    skillCategories.forEach(category => observer.observe(category));

    // Efecto hover para las cards de habilidades
    const skillCards = document.querySelectorAll('.skill-card');
    skillCards.forEach(card => {
      card.addEventListener('mouseenter', () => {
        (card as HTMLElement).style.transform = 'translateY(-10px) scale(1.05)';
      });
      
      card.addEventListener('mouseleave', () => {
        (card as HTMLElement).style.transform = 'translateY(0) scale(1)';
      });
    });
  });
</script>

<style>
  .skill-card {
